{
  "name": "@alunzadev/accessone-ui",
  "version": "0.1.0",
  "description": "Componentes, configuración y estilos compartidos para las landings de AccessOne.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlunzaDev/accessone-landing-packages.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles/tokens.css": "./dist/styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=5 <8",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "astro": "^7.4.7",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

