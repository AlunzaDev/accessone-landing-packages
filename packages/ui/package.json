{
  "name": "@alunzadev/accessone-ui",
  "version": "0.7.0",
  "description": "Componentes, configuraciÃ³n y estilos compartidos para las landings de AccessOne.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlunzaDev/accessone-landing-packages.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/service-card.css": "./dist/styles/service-card.css",
    "./styles/identity-tabs.css": "./dist/styles/identity-tabs.css",
    "./styles/service-catalog-card.css": "./dist/styles/service-catalog-card.css",
    "./styles/service-catalog.css": "./dist/styles/service-catalog.css",
    "./styles/glass.css": "./dist/styles/glass.css"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=5 <8",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "astro": "^7.4.7",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
